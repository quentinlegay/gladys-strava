{
  "manifest_version": 1,
  "type": "device",
  "name": "Strava",
  "description": {
    "en": "Your Strava activities and stats in Gladys: sensors, scene triggers and dashboard widgets.",
    "fr": "Vos activités et statistiques Strava dans Gladys : capteurs, scènes et widgets.",
    "de": "Ihre Strava-Aktivitäten und -Statistiken in Gladys: Sensoren, Szenen und Widgets.",
    "es": "Tus actividades y estadísticas de Strava en Gladys: sensores, escenas y widgets."
  },
  "version": "1.0.2",
  "docker_image": "ghcr.io/quentinlegay/gladys-strava:1.0.2",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/quentinlegay/gladys-strava/main/cover.png",
  "categories": ["services"],
  "transports": ["cloud"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Create your Strava API application",
        "fr": "Créez votre application d'API Strava",
        "de": "Erstellen Sie Ihre Strava-API-Anwendung",
        "es": "Crea tu aplicación de API de Strava"
      },
      "description": {
        "en": "On strava.com, open Settings > My API Application and create an application. As \"Authorization Callback Domain\", enter the host name you use to reach Gladys ({{gladys_host}}). Then copy its Client ID and Client Secret below, save, and click Connect.",
        "fr": "Sur strava.com, ouvrez Paramètres > Mon application d'API et créez une application. Comme « Authorization Callback Domain », saisissez le nom d'hôte par lequel vous accédez à Gladys ({{gladys_host}}). Copiez ensuite son Client ID et son Client Secret ci-dessous, enregistrez, puis cliquez sur Connecter.",
        "de": "Öffnen Sie auf strava.com Einstellungen > Meine API-Anwendung und erstellen Sie eine Anwendung. Geben Sie als „Authorization Callback Domain“ den Hostnamen ein, über den Sie Gladys erreichen ({{gladys_host}}). Kopieren Sie dann ihre Client ID und ihr Client Secret unten, speichern Sie und klicken Sie auf Verbinden.",
        "es": "En strava.com, abre Ajustes > Mi aplicación de API y crea una aplicación. Como «Authorization Callback Domain», introduce el nombre de host con el que accedes a Gladys ({{gladys_host}}). Después copia su Client ID y su Client Secret aquí abajo, guarda y haz clic en Conectar."
      },
      "links": [
        {
          "url": "https://www.strava.com/settings/api",
          "label": {
            "en": "My Strava API application",
            "fr": "Mon application d'API Strava",
            "de": "Meine Strava-API-Anwendung",
            "es": "Mi aplicación de API de Strava"
          }
        },
        {
          "url": "https://developers.strava.com/docs/getting-started/",
          "label": {
            "en": "Strava API documentation",
            "fr": "Documentation de l'API Strava",
            "de": "Dokumentation der Strava-API",
            "es": "Documentación de la API de Strava"
          }
        }
      ]
    },
    {
      "key": "client_id",
      "type": "string",
      "label": {
        "en": "Client ID",
        "fr": "Client ID",
        "de": "Client ID",
        "es": "Client ID"
      },
      "placeholder": {
        "en": "e.g. 123456",
        "fr": "ex. 123456",
        "de": "z. B. 123456",
        "es": "p. ej. 123456"
      },
      "required": true
    },
    {
      "key": "client_secret",
      "type": "secret",
      "label": {
        "en": "Client Secret",
        "fr": "Client Secret",
        "de": "Client Secret",
        "es": "Client Secret"
      },
      "required": true
    },
    {
      "key": "strava_account",
      "type": "oauth2",
      "label": {
        "en": "Strava account",
        "fr": "Compte Strava",
        "de": "Strava-Konto",
        "es": "Cuenta de Strava"
      },
      "description": {
        "en": "Save the Client ID and Client Secret first, then link your Strava account. Keep every permission ticked on the Strava page.",
        "fr": "Enregistrez d'abord le Client ID et le Client Secret, puis liez votre compte Strava. Laissez toutes les autorisations cochées sur la page Strava.",
        "de": "Speichern Sie zuerst die Client ID und das Client Secret und verknüpfen Sie dann Ihr Strava-Konto. Lassen Sie auf der Strava-Seite alle Berechtigungen angehakt.",
        "es": "Guarda primero el Client ID y el Client Secret y luego vincula tu cuenta de Strava. Deja marcados todos los permisos en la página de Strava."
      }
    },
    {
      "key": "preferences",
      "type": "section",
      "label": {
        "en": "Preferences",
        "fr": "Préférences",
        "de": "Einstellungen",
        "es": "Preferencias"
      },
      "description": {
        "en": "Optional: with Gladys Plus, paste your Open API key in the \"Gladys Plus webhooks\" block to get your new activities within seconds instead of at the next refresh.",
        "fr": "Facultatif : avec Gladys Plus, collez votre clé Open API dans le bloc « Webhooks Gladys Plus » pour recevoir vos nouvelles activités en quelques secondes, sans attendre le prochain rafraîchissement.",
        "de": "Optional: Fügen Sie mit Gladys Plus Ihren Open-API-Schlüssel im Block „Gladys Plus Webhooks“ ein, um neue Aktivitäten innerhalb von Sekunden statt erst bei der nächsten Aktualisierung zu erhalten.",
        "es": "Opcional: con Gladys Plus, pega tu clave Open API en el bloque «Webhooks de Gladys Plus» para recibir tus nuevas actividades en segundos en lugar de esperar a la próxima actualización."
      }
    },
    {
      "key": "units",
      "type": "select",
      "label": {
        "en": "Units",
        "fr": "Unités",
        "de": "Einheiten",
        "es": "Unidades"
      },
      "required": false,
      "default": "metric",
      "options": [
        {
          "value": "metric",
          "label": {
            "en": "Metric (km, m)",
            "fr": "Métrique (km, m)",
            "de": "Metrisch (km, m)",
            "es": "Métrico (km, m)"
          }
        },
        {
          "value": "imperial",
          "label": {
            "en": "Imperial (mi, ft)",
            "fr": "Impérial (mi, ft)",
            "de": "Imperial (mi, ft)",
            "es": "Imperial (mi, ft)"
          }
        }
      ]
    },
    {
      "key": "refresh_interval",
      "type": "number",
      "label": {
        "en": "Refresh interval (min)",
        "fr": "Intervalle de rafraîchissement (min)",
        "de": "Aktualisierungsintervall (min)",
        "es": "Intervalo de actualización (min)"
      },
      "description": {
        "en": "How often Strava is read, in minutes (5 to 240).",
        "fr": "Fréquence de lecture de Strava, en minutes (5 à 240).",
        "de": "Wie oft Strava gelesen wird, in Minuten (5 bis 240).",
        "es": "Frecuencia de lectura de Strava, en minutos (5 a 240)."
      },
      "required": false,
      "default": 15,
      "min": 5,
      "max": 240
    },
    {
      "key": "weekly_goal_type",
      "type": "select",
      "label": {
        "en": "Weekly goal type",
        "fr": "Type d'objectif hebdomadaire",
        "de": "Art des Wochenziels",
        "es": "Tipo de objetivo semanal"
      },
      "required": false,
      "default": "distance",
      "options": [
        {
          "value": "distance",
          "label": {
            "en": "Distance (km or mi)",
            "fr": "Distance (km ou mi)",
            "de": "Distanz (km oder mi)",
            "es": "Distancia (km o mi)"
          }
        },
        {
          "value": "time",
          "label": {
            "en": "Moving time (hours)",
            "fr": "Temps actif (heures)",
            "de": "Bewegungszeit (Stunden)",
            "es": "Tiempo activo (horas)"
          }
        }
      ]
    },
    {
      "key": "weekly_goal",
      "type": "number",
      "label": {
        "en": "Weekly goal",
        "fr": "Objectif hebdomadaire",
        "de": "Wochenziel",
        "es": "Objetivo semanal"
      },
      "description": {
        "en": "In km (or miles in imperial units) for a distance goal, in hours for a time goal, all sports together. 0 disables the goal.",
        "fr": "En km (ou en miles en unités impériales) pour un objectif de distance, en heures pour un objectif de durée, tous sports confondus. 0 désactive l'objectif.",
        "de": "In km (oder Meilen bei imperialen Einheiten) für ein Distanzziel, in Stunden für ein Zeitziel, alle Sportarten zusammen. 0 deaktiviert das Ziel.",
        "es": "En km (o millas en unidades imperiales) para un objetivo de distancia, en horas para un objetivo de tiempo, todos los deportes juntos. 0 desactiva el objetivo."
      },
      "placeholder": {
        "en": "e.g. 50",
        "fr": "ex. 50",
        "de": "z. B. 50",
        "es": "p. ej. 50"
      },
      "required": false,
      "default": 0,
      "min": 0,
      "max": 10000
    }
  ],
  "actions": [
    {
      "key": "test_connection",
      "label": {
        "en": "Test the connection",
        "fr": "Tester la connexion",
        "de": "Verbindung testen",
        "es": "Probar la conexión"
      },
      "timeout_seconds": 30
    },
    {
      "key": "sync_now",
      "label": {
        "en": "Synchronize now",
        "fr": "Synchroniser maintenant",
        "de": "Jetzt synchronisieren",
        "es": "Sincronizar ahora"
      },
      "timeout_seconds": 30
    },
    {
      "key": "disconnect",
      "label": {
        "en": "Unlink the Strava account",
        "fr": "Délier le compte Strava",
        "de": "Strava-Konto trennen",
        "es": "Desvincular la cuenta de Strava"
      },
      "timeout_seconds": 30
    }
  ],
  "webhooks": [
    {
      "key": "strava_events",
      "label": {
        "en": "New activities, instantly",
        "fr": "Nouvelles activités en temps réel",
        "de": "Neue Aktivitäten in Echtzeit",
        "es": "Nuevas actividades en tiempo real"
      },
      "mode": "sync"
    }
  ],
