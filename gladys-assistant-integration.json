  "scene_actions": [
    {
      "key": "sync_now",
      "label": {
        "en": "Synchronize Strava",
        "fr": "Synchroniser Strava",
        "de": "Strava synchronisieren",
        "es": "Sincronizar Strava"
      },
      "description": {
        "en": "Read Strava now: new activities fire their triggers right away.",
        "fr": "Lit Strava maintenant : les nouvelles activités déclenchent aussitôt leurs scènes.",
        "de": "Liest Strava sofort: Neue Aktivitäten lösen ihre Szenen direkt aus.",
        "es": "Lee Strava ahora: las nuevas actividades activan sus escenas al instante."
      },
      "timeout_seconds": 30,
      "outputs": [
        {
          "key": "linked",
          "type": "boolean",
          "label": {
            "en": "Account linked",
            "fr": "Compte lié",
            "de": "Konto verknüpft",
            "es": "Cuenta vinculada"
          }
        },
        {
          "key": "new_activities",
          "type": "number",
          "label": {
            "en": "New activities",
            "fr": "Nouvelles activités",
            "de": "Neue Aktivitäten",
            "es": "Nuevas actividades"
          }
        }
      ]
    },
    {
      "key": "get_stats",
      "label": {
        "en": "Get Strava statistics",
        "fr": "Obtenir les statistiques Strava",
        "de": "Strava-Statistiken abrufen",
        "es": "Obtener las estadísticas de Strava"
      },
      "description": {
        "en": "Distance, time, elevation and count of a period, for the following actions.",
        "fr": "Distance, temps, dénivelé et nombre d'une période, pour les actions suivantes.",
        "de": "Distanz, Zeit, Höhenmeter und Anzahl eines Zeitraums, für die folgenden Aktionen.",
        "es": "Distancia, tiempo, desnivel y número de un periodo, para las acciones siguientes."
      },
      "timeout_seconds": 30,
      "fields": [
        {
          "key": "period",
          "type": "select",
          "label": {
            "en": "Period",
            "fr": "Période",
            "de": "Zeitraum",
            "es": "Periodo"
          },
          "required": true,
          "default": "week",
          "options": [
            {
              "value": "week",
              "label": {
                "en": "This week",
